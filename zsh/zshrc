# Managed by github.com/brandoshmando/dotfiles — `make zsh` links this to ~/.zshrc.
# Anything machine-specific or secret belongs in ~/.zshrc.local (sourced last,
# never tracked) — `make zsh` creates it with notes on what belongs there.

# --- oh-my-zsh -------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# --- toolchains ------------------------------------------------------------
# Everything here is guarded, so a partial install still yields a working shell.

# /opt/homebrew on Apple Silicon, /usr/local on Intel.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x "$_brew" ] && eval "$("$_brew" shellenv)" && break
done
unset _brew

# ~/.local/bin holds the hx-steel wrapper (see `make helix`). Prepend so it
# wins over anything system-installed.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# gvm. Keep this line in sync with gvm-installer's own: it greps for a literal
# match before appending, and won't recognize the $HOME form.
[[ -s "$HOME/.gvm/scripts/gvm" ]] && source "$HOME/.gvm/scripts/gvm" 2>/dev/null
# Remove gvm's cd override — it calls _encode/_decode in subshells which are excluded
# from Claude Code's shell snapshot, causing "command not found" errors on every cd.
# Version switching still works manually via: gvm use go1.x.y
unfunction cd 2>/dev/null

# --- knowledge base --------------------------------------------------------
# basic-memory creates its default project here, which is also the Obsidian
# vault (see the obsidian target in the dotfiles Makefile).
export BASIC_MEMORY_HOME="$HOME/Documents/Obsidian Vault"

# --- prompt ----------------------------------------------------------------
# zmx session indicator
if [[ -n $ZMX_SESSION ]]; then
  export PS1="zmx@[$ZMX_SESSION] ${PS1}"
fi

# --- machine-local overrides (untracked) -----------------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
